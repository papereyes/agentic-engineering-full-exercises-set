diff --git a/06 Multi-Agent Workflows/exercise-01-parallel-worktree-feature-split/worktree-feature-app/scripts/test-worktree-verifier.mjs b/06 Multi-Agent Workflows/exercise-01-parallel-worktree-feature-split/worktree-feature-app/scripts/test-worktree-verifier.mjs
