sequenceDiagram
  actor Employee
  participant Application
  participant Manager
  participant PolicyEngine
  participant Security
  participant DataOwner
  participant IdentityProvider

  %% EDGE: WF-01
  Employee->>Application: Submit access request

  %% EDGE: WF-02
  Manager-->>Application: Approve manager review

  alt High risk
    %% EDGE: WF-03
    PolicyEngine->>Security: Route high-risk request to security review

    %% EDGE: WF-05
    Security-->>DataOwner: Approve high-risk access and open data owner review
  else Normal risk
    %% EDGE: WF-04
    DataOwner-->>Application: Open normal-risk data owner review
  end

  %% EDGE: WF-06
  DataOwner->>IdentityProvider: Approve data access and begin provisioning

  %% EDGE: WF-07
  IdentityProvider-->>Application: Access granted and identity group synced
