diff --git a/07 Docs & Diagrams/exercise-03-feature-visualization/diagrams/payment-sequence.mmd b/07 Docs & Diagrams/exercise-03-feature-visualization/diagrams/payment-sequence.mmd
new file mode 100644
index 0000000000000000000000000000000000000000..1079db8c8abc689ec63d1501ea09ef7efe80dc0f
--- /dev/null
+++ b/07 Docs & Diagrams/exercise-03-feature-visualization/diagrams/payment-sequence.mmd	
@@ -0,0 +1,53 @@
+sequenceDiagram
+  actor Shopper
+  participant CheckoutUI
+  participant Orchestrator
+  participant GatewayAdapter
+  participant Ledger
+  participant ReceiptNotifier
+  participant WebhookHandler
+
+  Shopper->>CheckoutUI: Confirm checkout
+  %% EDGE: VIS-01
+  CheckoutUI->>Orchestrator: Create payment intent
+  %% EDGE: VIS-02
+  Orchestrator->>GatewayAdapter: Request authorization
+  GatewayAdapter-->>Orchestrator: Authorization result
+
+  alt Authorization approved
+    %% EDGE: VIS-03
+    Orchestrator->>GatewayAdapter: Capture approved authorization
+    GatewayAdapter-->>Orchestrator: Capture settled
+    %% EDGE: VIS-04
+    Orchestrator->>Ledger: Write authorization and capture ledger records
+    %% EDGE: VIS-05
+    Orchestrator->>ReceiptNotifier: Create sent receipt status
+    %% EDGE: VIS-06
+    GatewayAdapter->>WebhookHandler: Deliver captured webhook event
+  else Authorization declined
+    Orchestrator->>Ledger: Write rejected payment failure record
+    Orchestrator->>ReceiptNotifier: Create blocked receipt status
+  end
+
+  WebhookHandler->>WebhookHandler: Verify signature before state access
+  alt Invalid signature
+    %% EDGE: VIS-08
+    WebhookHandler-->>GatewayAdapter: Reject invalid signature without state access
+  else Valid signature
+    WebhookHandler->>WebhookHandler: Check known gateway reference
+    alt Unknown reference
+      %% EDGE: VIS-09
+      WebhookHandler-->>GatewayAdapter: Reject unknown reference without mutation
+    else Known reference
+      WebhookHandler->>WebhookHandler: Check handled event IDs
+      alt First delivery
+        %% EDGE: VIS-07
+        WebhookHandler->>Ledger: Write one capture ledger record
+        %% EDGE: VIS-11
+        WebhookHandler-->>GatewayAdapter: Mark event handled and return recorded
+      else Duplicate delivery
+        %% EDGE: VIS-10
+        WebhookHandler-->>GatewayAdapter: Return already-handled without mutation
+      end
+    end
+  end
diff --git a/07 Docs & Diagrams/exercise-03-feature-visualization/diagrams/webhook-reconciliation-state.mmd b/07 Docs & Diagrams/exercise-03-feature-visualization/diagrams/webhook-reconciliation-state.mmd
