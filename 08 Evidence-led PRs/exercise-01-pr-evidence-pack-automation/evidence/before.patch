index 0000000000000000000000000000000000000000..a5fbe807a0dad3df9bedc016fdd086e4486ac1b1
--- /dev/null
+++ b/08 Evidence-led PRs/exercise-01-pr-evidence-pack-automation/pr-evidence-app/scripts/generate-pr-evidence.mjs	
@@ -0,0 +1,172 @@
+#!/usr/bin/env node
+// Builds a failure-preserving PR evidence pack from a protected check-results
+// fixture: copies every artifact, hashes it, writes pr-evidence.json and
+// summary.md, and exits with the fixture's original overall exit code so a
+// failing required check can never be reported (or merged) as green.
+import crypto from "node:crypto";
+import fs from "node:fs";
+import path from "node:path";
+
+function parseArgs(argv) {
+  const args = {};
+  for (let index = 0; index < argv.length; index += 1) {
+    const token = argv[index];
+    if (token.startsWith("--")) {
+      args[token.slice(2)] = argv[index + 1];
+      index += 1;
+    }
+  }
+  return args;
+}
+
+function sha256Buffer(buffer) {
+  return crypto.createHash("sha256").update(buffer).digest("hex");
+}
+
+function fail(message) {
+  console.error(`generate-pr-evidence: ${message}`);
+  process.exitCode = 2;
+  return null;
+}
+
+function resolveInside(root, candidate) {
+  if (typeof candidate !== "string" || candidate.trim() === "" || path.isAbsolute(candidate)) return null;
+  const absolute = path.resolve(root, candidate);
+  const withSep = `${root}${path.sep}`;
+  return absolute === root || absolute.startsWith(withSep) ? absolute : null;
+}
+
+function nonEmptyString(value) {
+  return typeof value === "string" && value.trim().length > 0;
+}
+
+function validateFixture(fixture, fixtureRoot, failures) {
+  if (fixture?.schemaVersion !== 1 || !Array.isArray(fixture?.checks) || fixture.checks.length === 0) {
+    failures.push("fixture must use schemaVersion 1 and contain a non-empty checks array");
+    return [];
+  }
+  const seenFilenames = new Set();
+  const resolvedSources = [];
+  fixture.checks.forEach((check, index) => {
+    const label = `check ${index + 1} (${check?.name ?? "unnamed"})`;
+    for (const field of ["name", "command", "result", "outputPath", "risk", "reviewerAction", "rollback"]) {
+      if (!nonEmptyString(check?.[field])) failures.push(`${label} is missing required field: ${field}`);
+    }
+    if (!Number.isInteger(check?.exitCode) || check.exitCode < 0) failures.push(`${label} has an invalid exitCode`);
+    if (!["passed", "failed"].includes(check?.result) || (check.result === "passed") !== (check.exitCode === 0)) {
+      failures.push(`${label} result and exitCode are inconsistent`);
+    }
+    const source = resolveInside(fixtureRoot, check?.outputPath);
+    if (!source) {
+      failures.push(`${label} outputPath escapes the fixture directory or is invalid`);
+      resolvedSources.push(null);
+    } else if (!fs.existsSync(source) || !fs.statSync(source).isFile()) {
+      failures.push(`${label} artifact is missing: ${check.outputPath}`);
+      resolvedSources.push(null);
+    } else {
+      resolvedSources.push(source);
+    }
+    const filename = nonEmptyString(check?.outputPath) ? path.basename(check.outputPath) : `unknown-${index}`;
+    if (seenFilenames.has(filename)) failures.push(`duplicate artifact filename: ${filename}`);
+    seenFilenames.add(filename);
+  });
+  return resolvedSources;
+}
+
+function main() {
+  const args = parseArgs(process.argv.slice(2));
+  const failures = [];
+
+  if (!nonEmptyString(args.fixture)) failures.push("--fixture <fixture.json> is required");
+  if (!nonEmptyString(args.output)) failures.push("--output <directory> is required");
+  if (!/^[a-f0-9]{40}$/.test(args.sha ?? "")) failures.push("--sha must be a 40-character lowercase hexadecimal Git SHA");
+  if (failures.length) return fail(failures.join("; "));
+
+  const fixturePath = path.resolve(process.cwd(), args.fixture);
+  const outputRoot = path.resolve(process.cwd(), args.output);
+  const sourceSha = args.sha;
+
+  if (!fs.existsSync(fixturePath) || !fs.statSync(fixturePath).isFile()) return fail(`fixture not found: ${fixturePath}`);
+  const fixtureBytes = fs.readFileSync(fixturePath);
+
+  let fixture;
+  try {
+    fixture = JSON.parse(fixtureBytes.toString("utf8"));
+  } catch {
+    return fail(`fixture is not valid JSON: ${fixturePath}`);
+  }
+
+  const fixtureRoot = path.dirname(fixturePath);
+  const resolvedSources = validateFixture(fixture, fixtureRoot, failures);
+  if (failures.length) return fail(failures.join("; "));
+
+  // Everything is valid: stage artifacts and evidence in memory-safe steps,
+  // writing the complete pack only once every copy has succeeded.
+  fs.mkdirSync(path.join(outputRoot, "artifacts"), { recursive: true });
+
+  const checks = fixture.checks.map((check, index) => {
+    const source = resolvedSources[index];
+    const filename = path.basename(check.outputPath);
+    const relativeArtifactPath = `artifacts/${filename}`;
+    const target = path.join(outputRoot, relativeArtifactPath);
+    const bytes = fs.readFileSync(source);
+    fs.writeFileSync(target, bytes);
+    return {
+      name: check.name,
+      command: check.command,
+      exitCode: check.exitCode,
+      result: check.result,
+      risk: check.risk,
+      reviewerAction: check.reviewerAction,
+      rollback: check.rollback,
+      artifact: { path: relativeArtifactPath, sha256: sha256Buffer(bytes) },
+    };
+  });
+
+  const firstFailure = checks.find((check) => check.exitCode !== 0);
+  const overallResult = firstFailure ? "failed" : "passed";
+  const overallExitCode = firstFailure ? firstFailure.exitCode : 0;
+
+  const pack = {
+    schemaVersion: 1,
+    sourceSha,
+    fixtureSha256: sha256Buffer(fixtureBytes),
+    overallResult,
+    overallExitCode,
+    checks,
+  };
+
+  fs.writeFileSync(path.join(outputRoot, "pr-evidence.json"), `${JSON.stringify(pack, null, 2)}\n`);
+
+  const summaryLines = [
+    "# PR Evidence Summary",
+    "",
+    `Source SHA: ${pack.sourceSha}`,
+    `Fixture SHA-256: ${pack.fixtureSha256}`,
+    `Overall result: ${pack.overallResult}`,
+    `Overall exit code: ${pack.overallExitCode}`,
+    "",
+  ];
+  for (const check of checks) {
+    summaryLines.push(
+      `## ${check.name}`,
+      "",
+      `- Command: ${check.command}`,
+      `- Result: ${check.result}`,
+      `- Exit code: ${check.exitCode}`,
+      `- Artifact: ${check.artifact.path}`,
+      `- Artifact SHA-256: ${check.artifact.sha256}`,
+      `- Risk: ${check.risk}`,
+      `- Reviewer action: ${check.reviewerAction}`,
+      `- Rollback: ${check.rollback}`,
+      "",
+    );
+  }
+  fs.writeFileSync(path.join(outputRoot, "summary.md"), `${summaryLines.join("\n")}\n`);
+
+  console.log(`PR evidence written to ${outputRoot} (overall: ${overallResult}, exit ${overallExitCode})`);
+  process.exitCode = overallExitCode;
+  return pack;
+}
+
+main();
