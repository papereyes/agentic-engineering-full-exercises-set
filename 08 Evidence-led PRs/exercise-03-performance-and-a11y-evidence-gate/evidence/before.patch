index 0000000000000000000000000000000000000000..a9d304cfef250ac1b3142c5808a9a8732521dc45
--- /dev/null
+++ b/08 Evidence-led PRs/exercise-03-performance-and-a11y-evidence-gate/quality-gate-app/scripts/quality-gate.mjs	
@@ -0,0 +1,72 @@
+import fs from "node:fs";
+import path from "node:path";
+import { expectedSummary, readAxeEvidence, readLighthouseReports } from "./quality-verification.mjs";
+
+// Pessimistic release gate: reads exactly three raw Lighthouse reports and one
+// raw axe report, validates them against the protected contract, and writes a
+// decision using the worst run across performance, accessibility, and LCP.
+// One bad run, or any axe violation, fails the whole release.
+
+function argument(name) {
+  const index = process.argv.indexOf(name);
+  if (index === -1 || !process.argv[index + 1]) throw new Error(`Missing ${name}`);
+  return process.argv[index + 1];
+}
+
+const lighthouseDir = argument("--lighthouse-dir");
+const axePath = argument("--axe");
+const contractPath = argument("--contract");
+const sourceSha = argument("--sha");
+const outputPath = argument("--output");
+
+const contract = JSON.parse(fs.readFileSync(contractPath, "utf8"));
+
+const validationFailures = [];
+if (!/^[a-f0-9]{40}$/.test(sourceSha)) validationFailures.push("--sha must be a full 40-character Git SHA");
+
+const lighthouse = readLighthouseReports(lighthouseDir, contract);
+validationFailures.push(...lighthouse.failures);
+
+const lighthouseBrowserMajor = lighthouse.runs[0]?.environment?.browserMajor ?? null;
+const axe = readAxeEvidence(axePath, sourceSha, contract, lighthouseBrowserMajor);
+validationFailures.push(...axe.failures);
+
+const hasCompleteEvidence =
+  lighthouse.runs.length === contract.lighthouseRuns &&
+  Boolean(axe.axe) &&
+  /^[a-f0-9]{40}$/.test(sourceSha);
+
+let summary;
+if (hasCompleteEvidence) {
+  summary = expectedSummary({ sourceSha, contract, runs: lighthouse.runs, axe: axe.axe });
+  if (validationFailures.length) {
+    summary = {
+      ...summary,
+      failures: [...new Set([...validationFailures, ...summary.failures])],
+      releaseDecision: "failed",
+    };
+  }
+} else {
+  summary = {
+    schemaVersion: 1,
+    sourceSha,
+    route: contract.route,
+    aggregation: contract.aggregation,
+    thresholds: contract.thresholds,
+    lighthouseRuns: lighthouse.runs,
+    axe: axe.axe,
+    worstCase: null,
+    failures: [...new Set(validationFailures.length ? validationFailures : ["insufficient evidence to compute a release decision"])],
+    releaseDecision: "failed",
+  };
+}
+
+fs.mkdirSync(path.dirname(outputPath), { recursive: true });
+fs.writeFileSync(outputPath, `${JSON.stringify(summary, null, 2)}\n`);
+
+console.log(`Source SHA: ${sourceSha}`);
+console.log(`Worst case: ${JSON.stringify(summary.worstCase)}`);
+console.log(`Release decision: ${summary.releaseDecision}`);
+if (summary.failures.length) console.log(`Failures: ${summary.failures.join(", ")}`);
+
+process.exitCode = summary.releaseDecision === "passed" ? 0 : 1;
