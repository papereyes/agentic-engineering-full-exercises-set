diff --git a/09 Code Review/exercise-01-security-and-a11y-review-gauntlet/review-gauntlet-app/tests/review-regressions.test.ts b/09 Code Review/exercise-01-security-and-a11y-review-gauntlet/review-gauntlet-app/tests/review-regressions.test.ts
