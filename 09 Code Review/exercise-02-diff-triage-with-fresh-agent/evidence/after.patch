diff --git a/09 Code Review/exercise-02-diff-triage-with-fresh-agent/fresh-review-app/tests/cache-regressions.test.ts b/09 Code Review/exercise-02-diff-triage-with-fresh-agent/fresh-review-app/tests/cache-regressions.test.ts
