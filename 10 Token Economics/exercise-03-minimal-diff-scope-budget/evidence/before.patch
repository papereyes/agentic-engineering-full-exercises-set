+import assert from "node:assert/strict";
+import { checkoutButton, deleteButton, exportButton, legacyActionButton } from "../src/migration/actionButtons.mjs";
+import { buttonVariantFor } from "../src/migration/exportButton.mjs";
+
+assert.equal(buttonVariantFor("export"), "ds-secondary", "export uses the design-system secondary variant");
+assert.equal(buttonVariantFor("checkout"), "legacy-primary", "checkout keeps the legacy primary variant");
+assert.equal(buttonVariantFor("delete"), "legacy-danger", "delete keeps the legacy danger variant");
+assert.equal(buttonVariantFor("unknown"), "legacy-primary", "unknown actions keep the legacy fallback");
+
+assert.deepEqual(exportButton(), { action: "export", label: "Export report", variant: "ds-secondary" });
+assert.deepEqual(checkoutButton(), { action: "checkout", label: "Continue to checkout", variant: "legacy-primary" });
+assert.deepEqual(deleteButton(), { action: "delete", label: "Delete record", variant: "legacy-danger" });
+assert.deepEqual(legacyActionButton("unknown", "Unknown"), {
+  action: "unknown",
+  label: "Unknown",
+  variant: "legacy-primary",
+});
+
+console.log("PASS export button variant regression coverage");
