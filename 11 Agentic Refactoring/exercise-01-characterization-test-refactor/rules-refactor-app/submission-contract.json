{
  "name": "Characterization-First Rules Refactor",
  "root": "..",
  "requiredFiles": [
    { "path": "evidence/before.md", "minCharacters": 250, "includeAll": ["Starting commit", "Run base commit", "Implementation commit", "Agent and model", "Tools and permissions", "Time limit", "Human hints: 0", "Retries: 0", "Patch SHA-256"] },
    { "path": "evidence/before.patch", "minCharacters": 80, "includeAll": ["diff --git"] },
    { "path": "evidence/after.md", "minCharacters": 250, "includeAll": ["Starting commit", "Run base commit", "Implementation commit", "Agent and model", "Tools and permissions", "Time limit", "Human hints: 0", "Retries: 0", "Patch SHA-256"] },
    { "path": "evidence/after.patch", "minCharacters": 80, "includeAll": ["diff --git"] },
    { "path": "evidence/comparison.md", "minCharacters": 500, "includeAll": ["Before", "After", "Same conditions", "Proof", "Conclusion"] },
    { "path": "rules-refactor-app/src/rules/legacyEligibility.characterization.test.mjs", "minCharacters": 700, "includeAll": ["evaluateRenewalEligibility", "renewal-golden-cases", "deepEqual"] },
    { "path": "evidence/before-output.json", "minCharacters": 2500, "validJson": true, "includeAll": ["enterprise accepts negative", "support override wins", "plan-not-supported"] },
    { "path": "evidence/after-output.json", "minCharacters": 2500, "validJson": true, "includeAll": ["enterprise accepts negative", "support override wins", "plan-not-supported"] },
    { "path": "evidence/history.json", "minCharacters": 150, "validJson": true, "includeAll": ["characterizationSha", "refactorSha"] },
    { "path": "evidence/behavior-decisions.md", "minCharacters": 900, "includeAll": ["preserve", "suspected bug", "support override", "negative", "plan-not-supported", "payment-history"] },
    { "path": "evidence/refactor-steps.md", "minCharacters": 700, "includeAll": ["characterization", "before", "green", "refactor", "after", "command"] },
    { "path": "evidence/commands/refactor-verify.txt", "minCharacters": 250, "includeAll": ["Command: npm run evidence:verify", "Repository commit:", "Started at:", "Finished at:", "Characterization SHA", "Refactor SHA", "twelve before and after", "evidence", "exit code: 0"] }
  ]
}
